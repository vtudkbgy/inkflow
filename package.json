{
  "name": "inkflow",
  "version": "1.0.0",
  "description": "InkFlow — Application de prise de notes manuscrites 100 % locale et hors-ligne (Windows Ink, PointerEvents, IndexedDB, PDF.js, Tauri v2)",
  "scripts": {
    "start": "npx serve . -l 5173",
    "build:app": "node scripts/build-app.js",
    "build:dist": "node scripts/prepare-dist.js",
    "test": "node scripts/run-unit-tests.js",
    "test:dist": "node scripts/run-unit-tests.js --target=dist/app.js",
    "verify:webview2": "node scripts/verify-webview2-pdf-stylus.js",
    "rea": "node scripts/rea-cli.js",
    "rea:setup": "node scripts/rea-cli.js setup",
    "rea:analyze": "node scripts/rea-cli.js analyze-javascript-application . --json",
    "tauri": "node scripts/tauri-runner.js",
    "tauri:dev": "node scripts/tauri-runner.js dev",
    "tauri:build": "node scripts/tauri-runner.js build",
    "install:start-menu": "powershell -ExecutionPolicy Bypass -File scripts/install-start-menu.ps1"
  },
  "keywords": [
    "handwriting",
    "notes",
    "stylus",
    "windows-ink",
    "pointer-events",
    "perfect-freehand",
    "indexeddb",
    "tauri",
    "pdf"
  ],
  "author": "InkFlow",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174"
  }
}
